@model VisualLayoutViewModel
@{
    var returnUrl = ViewData["returnUrl"]?.ToString();
}

<zone Name="Title"><h1>@RenderTitleSegments(T["Create Visual Layout"])</h1></zone>

<div asp-validation-summary="ModelOnly"></div>
<form asp-action="Create" asp-route-returnUrl="@ViewData["returnUrl"]" method="post" class="no-multisubmit">
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body p-3 text-end">
            <div class="btn-group">
                <button type="submit" name="submit" class="btn btn-primary save">@T["Save"]</button>
                <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-reference="parent" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span class="visually-hidden">@T["Toggle Dropdown"]</span>
                </button>
                <div class="dropdown-menu">
                    <button class="dropdown-item save-continue" name="submit" type="submit" value="SaveAndContinue">@T["and continue"]</button>
                </div>
            </div>

            @if (Url.IsLocalUrl(returnUrl))
            {
                <a class="btn btn-secondary cancel" role="button" href="@returnUrl">@T["Cancel"]</a>
            }

            <a class="btn btn-info" role="button" href="@Url.Action("Index", "Preview", new { area = "OrchardCore.VisualLayouts" })" target="_blank">@T["Preview"]</a>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="Name">
        <label asp-for="Name" class="ocat-label">@T["Name"]</label>
        <div class="ocat-end">
            <input asp-for="Name" class="form-control" autofocus />
            <span asp-validation-for="Name"></span>
            <span class="hint">@T["The name of the layout. It is also the name of the shape that this layout will override."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="Description">
        <label asp-for="Description" class="ocat-label">@T["Description"]</label>
        <div class="ocat-end">
            <input asp-for="Description" class="form-control" />
            <span class="hint">@T["The description of the layout."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="State">
        <label asp-for="State" class="ocat-label">@T["Layout"]</label>
        <div class="ocat-end">
            <div id="VisualLayoutEditor"
                 data-empty-text="@T["No rows yet. Click \"Add Row\" to start building the layout."]"
                 data-row-text="@T["Row"]"
                 data-add-column-text="@T["Add Column"]"
                 data-empty-columns-text="@T["No columns yet."]"
                 data-add-block-text="@T["Add Block"]"
                 data-empty-blocks-text="@T["Drag blocks here or use \"Add Block\"."]"
                 data-drag-text="@T["Drag to reorder"]"
                 class="border rounded p-3 mb-3">
                <div class="d-flex justify-content-end mb-2">
                    <button type="button" class="btn btn-sm btn-primary" data-vl-action="add-row">@T["Add Row"]</button>
                </div>
                <div data-vl-canvas></div>
            </div>
            <textarea asp-for="State" class="form-control d-none" rows="6"></textarea>
            <span asp-validation-for="State"></span>
            <span class="hint">@T["Design the layout visually above. The JSON representation is kept in sync automatically."]</span>
        </div>
    </div>
</form>

<script asp-name="visuallayout-editor" at="Foot"></script>
<script asp-name="visuallayout-preview-edit" at="Foot"></script>
<script at="Foot">
    (function () {
        var bootPreview = function () {
            if (typeof initializeVisualLayoutPreview === 'function') {
                initializeVisualLayoutPreview(document.getElementById('Name'), document.getElementById('State'));
            }
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bootPreview);
        } else {
            bootPreview();
        }
    })();
</script>
